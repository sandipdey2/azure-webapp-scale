[Unit]
Description=FastAPI app (Uvicorn)
After=network.target

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser
Environment="PATH=/home/azureuser/venv/bin"
ExecStart=/home/azureuser/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
