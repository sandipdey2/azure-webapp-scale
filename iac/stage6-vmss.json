{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "loadBalancers_myapp_vmss_lb_externalid": {
      "defaultValue": "/subscriptions/94ec3a64-dcfe-4219-9e29-88221690c382/resourceGroups/Regroup_5vlvpwituq/providers/Microsoft.Network/loadBalancers/myapp-vmss-lb",
      "type": "String"
    },
    "networkSecurityGroups_myapp_vmssNSG_externalid": {
      "defaultValue": "/subscriptions/94ec3a64-dcfe-4219-9e29-88221690c382/resourceGroups/Regroup_5vlvpwituq/providers/Microsoft.Network/networkSecurityGroups/myapp-vmssNSG",
      "type": "String"
    },
    "virtualMachineScaleSets_myapp_vmss_name": {
      "defaultValue": "myapp-vmss",
      "type": "String"
    },
    "virtualNetworks_myapp_vmssVNET_externalid": {
      "defaultValue": "/subscriptions/94ec3a64-dcfe-4219-9e29-88221690c382/resourceGroups/Regroup_5vlvpwituq/providers/Microsoft.Network/virtualNetworks/myapp-vmssVNET",
      "type": "String"
    }
  },
  "resources": [
    {
      "apiVersion": "2026-04-01",
      "location": "westus",
      "name": "[parameters('virtualMachineScaleSets_myapp_vmss_name')]",
      "properties": {
        "constrainedMaximumCapacity": false,
        "highSpeedInterconnectPlacement": "None",
        "orchestrationMode": "Flexible",
        "platformFaultDomainCount": 1,
        "singlePlacementGroup": false,
        "upgradePolicy": {
          "mode": "Manual"
        },
        "virtualMachineProfile": {
          "networkProfile": {
            "networkApiVersion": "2020-11-01",
            "networkInterfaceConfigurations": [
              {
                "name": "myapp25a6Nic",
                "properties": {
                  "auxiliaryMode": "None",
                  "auxiliarySku": "None",
                  "deleteOption": "Delete",
                  "disableTcpStateTracking": false,
                  "dnsSettings": {
                    "dnsServers": []
                  },
                  "enableIPForwarding": false,
                  "ipConfigurations": [
                    {
                      "name": "myapp25a6IPConfig",
                      "properties": {
                        "applicationGatewayBackendAddressPools": [],
                        "applicationSecurityGroups": [],
                        "loadBalancerBackendAddressPools": [
                          {
                            "id": "[concat(parameters('loadBalancers_myapp_vmss_lb_externalid'), concat('/backendAddressPools/', parameters('virtualMachineScaleSets_myapp_vmss_name'), '-lbBEPool'))]"
                          }
                        ],
                        "privateIPAddressVersion": "IPv4",
                        "subnet": {
                          "id": "[concat(parameters('virtualNetworks_myapp_vmssVNET_externalid'), concat('/subnets/', parameters('virtualMachineScaleSets_myapp_vmss_name'), 'Subnet'))]"
                        }
                      }
                    }
                  ],
                  "networkSecurityGroup": {
                    "id": "[parameters('networkSecurityGroups_myapp_vmssNSG_externalid')]"
                  },
                  "primary": true
                }
              }
            ]
          },
          "osProfile": {
            "adminUsername": "azureuser",
            "allowExtensionOperations": true,
            "computerNamePrefix": "myapp-vm",
            "linuxConfiguration": {
              "disablePasswordAuthentication": true,
              "enableVMAgentPlatformUpdates": true,
              "patchSettings": {
                "assessmentMode": "ImageDefault",
                "patchMode": "ImageDefault"
              },
              "provisionVMAgent": true,
              "ssh": {
                "publicKeys": [
                  {
                    "keyData": "ssh-rsa ",
                    "path": "/home/azureuser/.ssh/authorized_keys"
                  }
                ]
              }
            },
            "requireGuestProvisionSignal": true,
            "secrets": []
          },
          "securityProfile": {
            "securityType": "Standard"
          },
          "storageProfile": {
            "diskControllerType": "SCSI",
            "imageReference": {
              "offer": "0001-com-ubuntu-server-jammy",
              "publisher": "Canonical",
              "sku": "22_04-lts-gen2",
              "version": "latest"
            },
            "osDisk": {
              "caching": "ReadWrite",
              "createOption": "FromImage",
              "deleteOption": "Delete",
              "diskSizeGB": 30,
              "managedDisk": {
                "storageAccountType": "Premium_LRS"
              },
              "osType": "Linux"
            }
          }
        }
      },
      "sku": {
        "capacity": 1,
        "name": "Standard_B1s",
        "tier": "Standard"
      },
      "type": "Microsoft.Compute/virtualMachineScaleSets"
    },
    {
      "apiVersion": "2026-04-01",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachineScaleSets', parameters('virtualMachineScaleSets_myapp_vmss_name'))]"
      ],
      "location": "westus",
      "name": "[concat(parameters('virtualMachineScaleSets_myapp_vmss_name'), '/', parameters('virtualMachineScaleSets_myapp_vmss_name'), '_ee1dff36')]",
      "type": "Microsoft.Compute/virtualMachineScaleSets/virtualMachines",
      "zones": [
        null
      ]
    }
  ],
  "variables": {}
}
