      "type": "String"
    },
    "networkInterfaces_myapp_vm_b1sVMNic_externalid": {
      "defaultValue": "/subscriptions/94ec3a64-dcfe-4219-9e29-88221690c382/resourceGroups/Regroup_1acmbdgntz/providers/Microsoft.Network/networkInterfaces/myapp-vm-b1sVMNic",
